<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.leewyatt.rxcontrols.RXDecimalField?>
<?import io.github.leewyatt.rxcontrols.RXDoubleField?>
<?import io.github.leewyatt.rxcontrols.RXIntegerField?>
<?import io.github.leewyatt.rxcontrols.RXLongField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="511.0" prefWidth="761.0" styleClass="number-field-page"
            stylesheets="@../css/pane-number-field.css"
            xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="io.github.leewyatt.rxcontrols.samples.support.controller.PaneNumberFieldController">
    <children>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll"
                    AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox spacing="16.0" styleClass="page-content">
                    <children>
                        <VBox spacing="6.0">
                            <children>
                                <Label styleClass="page-title" text="数字输入框"/>
                                <Label styleClass="page-subtitle"
                                       text="强类型数字文本框：Integer / Long / Double / BigDecimal 各归其位，可设上下限，BigDecimal 版支持 NumberFormat 格式化。"/>
                            </children>
                        </VBox>

                        <VBox spacing="10.0">
                            <children>
                                <Label styleClass="section-title" text="四种数字输入框"/>
                                <HBox alignment="CENTER" spacing="20.0" styleClass="field-row">
                                    <children>
                                        <VBox alignment="CENTER" spacing="10.0" styleClass="field-item">
                                            <children>
                                                <RXIntegerField fx:id="integerField" prefColumnCount="11"
                                                                value="2048" min="0"/>
                                                <Label styleClass="field-caption" text="RXIntegerField · Integer 整数"/>
                                            </children>
                                        </VBox>
                                        <VBox alignment="CENTER" spacing="10.0" styleClass="field-item">
                                            <children>
                                                <RXLongField fx:id="longField" prefColumnCount="11"
                                                             value="9007199254740993"/>
                                                <Label styleClass="field-caption" text="RXLongField · Long 长整数"/>
                                            </children>
                                        </VBox>
                                        <VBox alignment="CENTER" spacing="10.0" styleClass="field-item">
                                            <children>
                                                <RXDoubleField fx:id="doubleField" prefColumnCount="11"
                                                               value="3.14159"/>
                                                <Label styleClass="field-caption" text="RXDoubleField · Double 浮点"/>
                                            </children>
                                        </VBox>
                                        <VBox alignment="CENTER" spacing="10.0" styleClass="field-item">
                                            <children>
                                                <RXDecimalField fx:id="decimalField" prefColumnCount="11"
                                                                value="1234567.89"/>
                                                <Label styleClass="field-caption" text="RXDecimalField · 精确十进制"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox spacing="10.0">
                            <children>
                                <Label styleClass="section-title" text="RXDecimalField · 多种格式"/>
                                <HBox alignment="CENTER" spacing="20.0" styleClass="field-row">
                                    <children>
                                        <VBox alignment="CENTER" spacing="10.0" styleClass="field-item">
                                            <children>
                                                <RXDecimalField fx:id="groupingField" prefColumnCount="14"/>
                                                <Label styleClass="field-caption" text="千分位分组"/>
                                            </children>
                                        </VBox>
                                        <VBox alignment="CENTER" spacing="10.0" styleClass="field-item">
                                            <children>
                                                <RXDecimalField fx:id="currencyField" prefColumnCount="14"/>
                                                <Label styleClass="field-caption" text="货币 (en-US)"/>
                                            </children>
                                        </VBox>
                                        <VBox alignment="CENTER" spacing="10.0" styleClass="field-item">
                                            <children>
                                                <RXDecimalField fx:id="percentField" prefColumnCount="14"/>
                                                <Label styleClass="field-caption" text="百分比"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox spacing="10.0">
                            <children>
                                <Label styleClass="section-title" text="前置 / 后置插槽 · setLeading / setTrailing"/>
                                <HBox alignment="CENTER" spacing="20.0" styleClass="field-row">
                                    <children>
                                        <VBox alignment="CENTER" spacing="10.0" styleClass="field-item">
                                            <children>
                                                <RXDecimalField fx:id="leftSlotField" prefColumnCount="11">
                                                    <leading>
                                                        <StackPane styleClass="slot-box">
                                                            <children>
                                                                <Label styleClass="slot-money" text="\$"/>
                                                            </children>
                                                        </StackPane>
                                                    </leading>
                                                </RXDecimalField>
                                                <Label styleClass="field-caption" text="前置插槽 · 货币前缀"/>
                                            </children>
                                        </VBox>
                                        <VBox alignment="CENTER" spacing="10.0" styleClass="field-item">
                                            <children>
                                                <RXDecimalField fx:id="rightSlotField" prefColumnCount="11">
                                                    <trailing>
                                                        <StackPane styleClass="slot-box">
                                                            <children>
                                                                <Label styleClass="slot-unit" text="kg"/>
                                                            </children>
                                                        </StackPane>
                                                    </trailing>
                                                </RXDecimalField>
                                                <Label styleClass="field-caption" text="后置插槽 · 单位后缀"/>
                                            </children>
                                        </VBox>
                                        <VBox alignment="CENTER" spacing="10.0" styleClass="field-item">
                                            <children>
                                                <RXDecimalField fx:id="dualSlotField" prefColumnCount="11">
                                                    <leading>
                                                        <StackPane styleClass="slot-box">
                                                            <children>
                                                                <Label styleClass="slot-temp" text="T"/>
                                                            </children>
                                                        </StackPane>
                                                    </leading>
                                                    <trailing>
                                                        <StackPane styleClass="slot-box">
                                                            <children>
                                                                <Label styleClass="slot-unit" text="°C"/>
                                                            </children>
                                                        </StackPane>
                                                    </trailing>
                                                </RXDecimalField>
                                                <Label styleClass="field-caption" text="前置 + 后置双插槽"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <Label maxWidth="Infinity" styleClass="field-note"
                               text="前置 / 后置插槽接受任意节点，可放符号、单位、图标或按钮；键入时非法字符被即时过滤，超出 min / max 的值在提交时自动夹紧。"/>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
