<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.leewyatt.rxcontrols.layout.RXColSpec?>
<?import io.github.leewyatt.rxcontrols.layout.RXCol?>
<?import io.github.leewyatt.rxcontrols.layout.RXRow?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" pannable="true"
            styleClass="responsive-fxml-scroll"
            stylesheets="@rx-row-fxml-demo.css"
            xmlns="http://javafx.com/javafx/17">
    <content>
        <!--
          Layout context (default ANT_DESIGN profile):
            Grid:         24 columns; breakpoints xs(0) sm(576) md(768) lg(992) xl(1200) xxl(1600) xxxl(1920).
            Mobile-first: a field unset at a breakpoint inherits the nearest smaller breakpoint,
                          finally the column base (span=24 = full width, offset=0, order=0, hidden=false).
            DSL:          1st positional = span, 2nd positional = offset;
                          key=value supports span/offset/order/hidden (RXColSpec.valueOf).
          An attribute that only repeats the inherited value can be dropped — see each column below.
        -->
        <RXRow align="STRETCH" gutter="18.0" justify="START"
                         rowGap="18.0" styleClass="responsive-fxml-page">
            <children>
                <!--
                  Hero — full width at the narrow breakpoints (xs/sm), 16 cols at md, 14 at lg+.
                  Reading the syntax: the attribute name is the breakpoint, its value is the span.
                  So xs="24" = "at xs, span 24 columns", and since the grid is 24 wide that is full width;
                  md="16" = 16 of 24 columns at md, etc.
                  As written:
                    <RXCol xs="24" sm="24" md="16" lg="14">
                  sm inherits xs's 24, so equivalently:
                    <RXCol xs="24" md="16" lg="14">
                -->
                <RXCol xs="24" sm="24" md="16" lg="14">

                    <children>
                        <VBox spacing="10.0" styleClass="hero-card">
                            <children>
                                <Label styleClass="eyebrow" text="OPERATIONS"/>
                                <Label styleClass="hero-title"
                                       text="Adaptive service queue for regional support teams."
                                       wrapText="true"/>
                                <Label styleClass="hero-copy"
                                       text="Incidents, response load, and customer health stay readable as the window changes width."
                                       wrapText="true"/>
                                <HBox spacing="10.0" styleClass="hero-actions">
                                    <children>
                                        <Button styleClass="primary-button" text="Review queue"/>
                                        <Button styleClass="secondary-button" text="Open reports"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </RXCol>

                <!--
                  Status — full width at the narrow breakpoints (xs/sm), 8 cols at md, 10 at lg+.
                  As written:
                    <RXCol xs="24" sm="24" md="8" lg="10">
                  sm inherits xs's 24, so equivalently:
                    <RXCol xs="24" md="8" lg="10">
                -->
                <RXCol xs="24" sm="24" md="8" lg="10">
                    <children>
                        <VBox spacing="9.0" styleClass="status-card">
                            <children>
                                <Label styleClass="card-title" text="Today"/>
                                <Label styleClass="status-value" text="142"/>
                                <Label styleClass="card-copy"
                                       text="Open requests across three service regions."
                                       wrapText="true"/>
                                <Region styleClass="status-rule"/>
                                <Label styleClass="status-note" text="Peak load expected at 16:30"/>
                            </children>
                        </VBox>
                    </children>
                </RXCol>

                <!--
                  SLA — full width at xs, 12 cols at sm/md, 8 at lg+; order=1 pulls it ahead at lg.
                  Reading lg="8,0,order=1": a value may carry several fields separated by commas.
                  The 1st number is span, the 2nd is offset; order/hidden are keyword-only.
                  So 8 = span, 0 = offset, order=1 = visual order → span 8, offset 0, order 1 at lg.
                  As written:
                    <RXCol xs="24" sm="12" md="12" lg="8,0,order=1">
                  md inherits sm's 12, and offset 0 is a no-op (offset was never moved), so equivalently:
                    <RXCol xs="24" sm="12" lg="8,order=1">
                -->
                <RXCol xs="24" sm="12" md="12" lg="8,0,order=1">
                    <children>
                        <VBox spacing="8.0" styleClass="metric-card">
                            <children>
                                <Region styleClass="metric-accent-green"/>
                                <Label styleClass="metric-title" text="SLA health"/>
                                <Label styleClass="metric-value" text="99.8%"/>
                                <Label styleClass="metric-copy" text="+0.4% from last week"/>
                            </children>
                        </VBox>
                    </children>
                </RXCol>

                <!--
                  Median response — explicit element form (RXColSpec children, @NamedArg path).
                  Resolved: xs 24, sm 12, md 12, lg 8 (offset 0, order 2); xl+ inherits lg.
                  Equivalent attribute shorthand:
                    <RXCol xs="24" sm="12" md="12" lg="8,0,order=2">
                  md inherits sm's 12, so minimally:
                    <RXCol xs="24" sm="12" lg="8,order=2">
                  Some IDEs may mark span/offset/order below as read-only; FXMLLoader uses RXColSpec's
                  @NamedArg constructor at runtime, so it still loads correctly.
                -->
                <RXCol>
                    <xs>
                        <RXColSpec span="24"/>
                    </xs>
                    <sm>
                        <RXColSpec span="12"/>
                    </sm>
                    <md>
                        <RXColSpec span="12"/>
                    </md>
                    <lg>
                        <RXColSpec span="8" offset="0" order="2"/>
                    </lg>
                    <children>
                        <VBox spacing="8.0" styleClass="metric-card">
                            <children>
                                <Region styleClass="metric-accent-blue"/>
                                <Label styleClass="metric-title" text="Median response"/>
                                <Label styleClass="metric-value" text="11 min"/>
                                <Label styleClass="metric-copy" text="4 min faster than target"/>
                            </children>
                        </VBox>
                    </children>
                </RXCol>

                <!--
                  Escalations — full width until lg, then 8 columns.
                  As written:
                    <RXCol xs="24" sm="24" md="24" lg="8">
                  sm/md inherit xs's 24:
                    <RXCol xs="24" lg="8">
                  xs also only restates the base default (24 = full width), so minimally:
                    <RXCol lg="8">
                -->
                <RXCol xs="24" sm="24" md="24" lg="8">
                    <children>
                        <VBox spacing="8.0" styleClass="metric-card">
                            <children>
                                <Region styleClass="metric-accent-gold"/>
                                <Label styleClass="metric-title" text="Escalations"/>
                                <Label styleClass="metric-value" text="7"/>
                                <Label styleClass="metric-copy" text="2 require manager review"/>
                            </children>
                        </VBox>
                    </children>
                </RXCol>

                <!--
                  Callout — hidden at xs, shown from sm up; 20 cols (offset 2) at md, 18 (offset 3) at lg+.
                  As written:
                    <RXCol xs="span=24,hidden=true" sm="span=24,hidden=false" md="20,2" lg="18,3">
                  span=24 only restates the base default; xs/sm just toggle hidden, so equivalently:
                    <RXCol xs="hidden=true" sm="hidden=false" md="20,2" lg="18,3">
                  Keep sm="hidden=false" — dropping it leaves the column hidden at sm and up.
                -->
                <RXCol xs="span=24,hidden=true" sm="span=24,hidden=false"
                                 md="20,2" lg="18,3">
                    <children>
                        <HBox spacing="14.0" styleClass="callout-card">
                            <children>
                                <VBox HBox.hgrow="ALWAYS" maxWidth="Infinity" spacing="3.0">
                                    <children>
                                        <Label styleClass="callout-title"
                                               text="Offset column"/>
                                        <Label styleClass="callout-copy"
                                               text="A centered assignment strip keeps priority work visible without taking the full dashboard width."
                                               wrapText="true"/>
                                    </children>
                                </VBox>
                                <Button styleClass="callout-button" text="Assign"/>
                            </children>
                        </HBox>
                    </children>
                </RXCol>
            </children>
        </RXRow>
    </content>
</ScrollPane>
